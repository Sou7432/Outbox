generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
  DELAYED
  CANCELLED
}

model Email {
  id                 String       @id @default(uuid())
  recipient          String
  subject            String
  body               String       @db.Text
  senderEmail        String
  scheduledAt        DateTime
  sentAt             DateTime?
  status             EmailStatus  @default(SCHEDULED)
  jobId              String?      @unique
  error              String?      @db.Text
  etherealPreviewUrl String?      @db.Text
  attemptCount       Int          @default(0)
  campaignId         String?
  metadata           String?      @db.Text
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([senderEmail])
  @@index([recipient])
}

model Sender {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  hourlyLimit  Int      @default(50)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SlackIntegration {
  id           String   @id @default(uuid())
  webhookUrl   String?  @db.Text
  channel      String?
  accessToken  String?  @db.Text
  teamId       String?
  teamName     String?
  active       Boolean  @default(true)
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  picture   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
