# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Redis (BullMQ queue & rate limiter)
REDIS_URL=redis://localhost:6379

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox_scheduler?schema=public

# Elasticsearch (Search indexing)
ELASTICSEARCH_URL=http://localhost:9200

# Concurrency & Rate Limiting
WORKER_CONCURRENCY=5
EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=50
MAX_EMAILS_PER_HOUR=200

# Default Sender
DEFAULT_SENDER_EMAIL=outreach@reachinbox.test
DEFAULT_SENDER_NAME="ReachInbox Growth"

# SMTP (Optional: Leave empty to auto-generate Ethereal Email test accounts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Slack Integration (OAuth or Incoming Webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/oauth/callback
